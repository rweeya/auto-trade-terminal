<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auto Trade | Terminal</title>
    
    <!-- Шрифты -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Orbitron', monospace;
            background: #000;
            overflow: hidden;
            height: 100vh;
        }

        /* Canvas для 3D фона */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        /* Контент поверх фона */
        .terminal {
            position: relative;
            z-index: 10;
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(5px);
        }

        /* Хедер */
        .header {
            padding: 20px 40px;
            background: linear-gradient(135deg, rgba(139, 0, 255, 0.3), rgba(0, 255, 255, 0.1));
            border-bottom: 1px solid rgba(0, 255, 255, 0.5);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .logo h1 {
            font-family: 'Orbitron', monospace;
            font-size: 28px;
            background: linear-gradient(135deg, #ff00ff, #00ffff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: glow 2s ease-in-out infinite alternate;
        }

        @keyframes glow {
            from { text-shadow: 0 0 10px rgba(0, 255, 255, 0.5); }
            to { text-shadow: 0 0 30px rgba(255, 0, 255, 0.8); }
        }

        .status {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .live-badge {
            background: #ff00ff33;
            padding: 8px 20px;
            border-radius: 40px;
            border: 1px solid #ff00ff;
            font-size: 14px;
            font-weight: bold;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .time-badge {
            background: #000000aa;
            padding: 8px 20px;
            border-radius: 40px;
            font-family: monospace;
            font-size: 14px;
            backdrop-filter: blur(5px);
        }

        /* Основная панель (пока заглушка) */
        .dashboard {
            flex: 1;
            padding: 20px 40px;
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .info-panel {
            flex: 1;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(0, 255, 255, 0.3);
            padding: 20px;
            min-width: 300px;
        }

        .info-panel h3 {
            color: #00ffff;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 15px;
            text-align: center;
        }

        .stat-value {
            font-size: 32px;
            font-weight: bold;
            color: #ff00ff;
        }

        .stat-label {
            font-size: 11px;
            color: #aaa;
            margin-top: 5px;
        }

        /* Панель сигналов (будет позже) */
        .signals-panel {
            flex: 2;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(0, 255, 255, 0.3);
            padding: 20px;
            min-width: 500px;
            overflow-y: auto;
        }

        .signals-container {
            max-height: 400px;
            overflow-y: auto;
        }

        .signal-card {
            background: linear-gradient(135deg, rgba(255, 0, 255, 0.1), rgba(0, 255, 255, 0.05));
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 10px;
            border-left: 4px solid #ff00ff;
            cursor: pointer;
            transition: all 0.3s;
        }

        .signal-card:hover {
            transform: translateX(5px);
            background: rgba(255, 0, 255, 0.2);
        }

        .signal-symbol {
            font-size: 18px;
            font-weight: bold;
        }

        .signal-action {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .buy { background: #00ff88; color: #000; }
        .sell { background: #ff4444; color: #fff; }

        .footer {
            text-align: center;
            padding: 15px;
            font-size: 11px;
            color: #666;
            background: rgba(0, 0, 0, 0.5);
        }

        /* Скролл */
        .signals-container::-webkit-scrollbar {
            width: 5px;
        }
        .signals-container::-webkit-scrollbar-track {
            background: #1a1a2e;
        }
        .signals-container::-webkit-scrollbar-thumb {
            background: #ff00ff;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <canvas id="bg-canvas"></canvas>

    <div class="terminal">
        <div class="header">
            <div class="logo">
                <h1>⚡ AUTO TRADE ⚡</h1>
            </div>
            <div class="status">
                <div class="live-badge">🟢 LIVE DATA</div>
                <div class="time-badge" id="liveTime">--:--:--</div>
            </div>
        </div>

        <div class="dashboard">
            <div class="info-panel">
                <h3>📊 СТАТИСТИКА</h3>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-value" id="totalSignals">0</div>
                        <div class="stat-label">ВСЕГО</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" id="buySignals">0</div>
                        <div class="stat-label">BUY</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" id="sellSignals">0</div>
                        <div class="stat-label">SELL</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" id="accuracy">—</div>
                        <div class="stat-label">ТОЧНОСТЬ</div>
                    </div>
                </div>
            </div>

            <div class="signals-panel">
                <h3>🎯 СИГНАЛЫ В РЕАЛЬНОМ ВРЕМЕНИ</h3>
                <div class="signals-container" id="signalsContainer">
                    <div style="text-align: center; padding: 40px; color: #888;">
                        ⏳ Ожидание сигналов...
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            🔮 Киберпанк терминал | Клик по сигналу → график Bybit | Мульти-индикаторный анализ
        </div>
    </div>

    <script type="module">
        // ========== 3D КИБЕРПАНК ФОН ==========
        import * as THREE from 'https://unpkg.com/three@0.128.0/build/three.module.js';

        const canvas = document.getElementById('bg-canvas');
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x050510);
        
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 0, 15);
        
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: false });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        
        // Создаём вращающуюся кибер-сетку
        const gridHelper = new THREE.GridHelper(30, 40, 0xff00ff, 0x00ffff);
        gridHelper.position.y = -3;
        scene.add(gridHelper);
        
        // Добавляем куб с неоновыми гранями
        const geometry = new THREE.BoxGeometry(3, 3, 3);
        const edges = new THREE.EdgesGeometry(geometry);
        const wireframe = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({ color: 0xff00ff }));
        scene.add(wireframe);
        
        // Парящие частицы
        const particleCount = 1500;
        const particlesGeometry = new THREE.BufferGeometry();
        const particlesPositions = new Float32Array(particleCount * 3);
        
        for (let i = 0; i < particleCount; i++) {
            particlesPositions[i * 3] = (Math.random() - 0.5) * 50;
            particlesPositions[i * 3 + 1] = (Math.random() - 0.5) * 30;
            particlesPositions[i * 3 + 2] = (Math.random() - 0.5) * 30 - 15;
        }
        
        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(particlesPositions, 3));
        const particlesMaterial = new THREE.PointsMaterial({ color: 0x00ffff, size: 0.08 });
        const particles = new THREE.Points(particlesGeometry, particlesMaterial);
        scene.add(particles);
        
        // Добавляем свет
        const ambientLight = new THREE.AmbientLight(0x404060);
        scene.add(ambientLight);
        const pointLight = new THREE.PointLight(0xff00ff, 1, 30);
        pointLight.position.set(2, 3, 4);
        scene.add(pointLight);
        
        let time = 0;
        
        function animate() {
            requestAnimationFrame(animate);
            time += 0.005;
            
            wireframe.rotation.x = time * 0.3;
            wireframe.rotation.y = time * 0.5;
            particles.rotation.y = time * 0.05;
            gridHelper.rotation.z = Math.sin(time * 0.1) * 0.1;
            
            renderer.render(scene, camera);
        }
        
        animate();
        
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
        
        // ========== ОБНОВЛЕНИЕ ВРЕМЕНИ ==========
        function updateTime() {
            const now = new Date();
            document.getElementById('liveTime').innerHTML = now.toLocaleTimeString('ru-RU');
        }
        updateTime();
        setInterval(updateTime, 1000);
        
        // ========== ЗАГЛУШКА ДЛЯ СИГНАЛОВ (пока тестовые данные) ==========
        async function loadSignals() {
            try {
                // Пробуем подключиться к твоему серверу
                const response = await fetch('/api/signals');
                const signals = await response.json();
                renderSignals(signals);
                updateStats(signals);
            } catch (e) {
                console.log('Сервер ещё не подключён, показываем тестовые данные');
                // Тестовые данные для демонстрации
                const testSignals = [
                    { symbol: 'BTC/USDT', action: 'buy', price: 68500, rsi: 32, timestamp: new Date().toISOString(), reason: 'RSI перепродан, EMA бычий' },
                    { symbol: 'ETH/USDT', action: 'sell', price: 3450, rsi: 72, timestamp: new Date().toISOString(), reason: 'RSI перекуплен, MACD медвежий' },
                    { symbol: 'SOL/USDT', action: 'buy', price: 165, rsi: 28, timestamp: new Date().toISOString(), reason: 'Стохастик на дне, ADX сильный' },
                ];
                renderSignals(testSignals);
                updateStats(testSignals);
            }
        }
        
        function renderSignals(signals) {
            const container = document.getElementById('signalsContainer');
            if (!signals || signals.length === 0) {
                container.innerHTML = '<div style="text-align: center; padding: 40px;">📭 Нет сигналов</div>';
                return;
            }
            
            let html = '';
            for (let s of signals) {
                const actionClass = s.action === 'buy' ? 'buy' : 'sell';
                const actionText = s.action === 'buy' ? '🟢 BUY' : '🔴 SELL';
                const time = new Date(s.timestamp).toLocaleTimeString();
                
                html += `
                    <div class="signal-card" onclick="window.open('https://www.bybit.com/trade/spot/${s.symbol.replace('/USDT', '').replace('USDT', '')}/USDT?interval=60', '_blank')">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="signal-symbol">💰 ${s.symbol}</span>
                            <span class="signal-action ${actionClass}">${actionText}</span>
                        </div>
                        <div style="display: flex; gap: 20px; margin-top: 10px; font-size: 12px; color: #aaa;">
                            <span>💵 $${Number(s.price).toLocaleString()}</span>
                            <span>📊 RSI: ${s.rsi || '-'}</span>
                            <span>⏰ ${time}</span>
                        </div>
                        <div style="margin-top: 8px; font-size: 11px; color: #888;">📝 ${s.reason || 'Мульти-индикаторный сигнал'}</div>
                    </div>
                `;
            }
            container.innerHTML = html;
        }
        
        function updateStats(signals) {
            const total = signals.length;
            const buys = signals.filter(s => s.action === 'buy').length;
            const sells = total - buys;
            document.getElementById('totalSignals').innerText = total;
            document.getElementById('buySignals').innerText = buys;
            document.getElementById('sellSignals').innerText = sells;
        }
        
        // Загружаем сигналы
        loadSignals();
        setInterval(loadSignals, 15000);
    </script>
</body>
</html>